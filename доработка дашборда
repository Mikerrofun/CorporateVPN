+import { NextResponse } from "next/server";
+
+import { createTicket } from "@/3features/support";
+import { ErrorCode } from "@/5shared/lib/errors";
+
+export async function POST(req: Request) {
+  const body = await req.json().catch(() => null);
+
+  const result = await createTicket(body);
+  if (!result.ok) {
+    const status = result.errorCode === ErrorCode.UNAUTHORIZED ? 401 : 400;
+    return NextResponse.json({ errorCode: result.errorCode }, { status });
+  }
+
+  return NextResponse.json({ ok: true }, { status: 201 });
+}
